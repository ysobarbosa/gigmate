{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@gigmate/musicians/domain": ["./libs/musicians/domain/src/index.ts"],
      "@gigmate/musicians/data-access": [
        "./libs/musicians/data-access/src/index.ts"
      ],
      "@gigmate/musicians/ui": ["./libs/musicians/ui/src/index.ts"],
      "@gigmate/musicians/feature-deck": [
        "./libs/musicians/feature-deck/src/index.ts"
      ],
      "@gigmate/musicians/feature-profile": [
        "./libs/musicians/feature-profile/src/index.ts"
      ],
      "@gigmate/musicians/feature-matches": [
        "./libs/musicians/feature-matches/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
